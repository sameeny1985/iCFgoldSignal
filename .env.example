# Copy to .env or set as Environment Variables on Render

# Telegram (required)
TELEGRAM_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PUT_YOUR_CHAT_ID_HERE

# Symbol for yfinance (forex examples)
# EURUSD=X   GBPUSD=X   USDJPY=X   XAUUSD=X   BTC-USD
SYMBOL=EURUSD=X

# How often to check (seconds)
POLL_INTERVAL_SEC=20

# Original MQ5 parameters (most used now)
CooldownMinutes=3
Sto_OverBuy_Crs=70
Sto_OverSell_Crs=30
Sto_OverBuy_Ext=80
Sto_OverSell_Ext=20
RSI_Period=8
RSI_OverBuy=70
RSI_OverSell=30
BB_Period=20
BB_Dev=2.0
MA1_Period=10
MA2_Period=21
